{
  "name": "chatapp",
  "private": true,
  "version": "1.0.0",
  "main": "expo-router/entry",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "bun run --filter @chatapp/mobile start",
    "mobile": "bun run --filter @chatapp/mobile start",
    "android": "bun run --filter @chatapp/mobile start --android",
    "ios": "bun run --filter @chatapp/mobile start --ios",
    "web": "bun run --filter @chatapp/mobile start --web",
    "backend": "bun run --filter @chatapp/backend dev",
    "db:migrate": "bun run --filter @chatapp/backend db:migrate",
    "db:generate": "bun run --filter @chatapp/backend db:generate",
    "postinstall": "node scripts/patch-expo-audio.js"
  },
  "workspaces": [
    "apps/*",
    "backend",
    "packages/*"
  ],
  "devDependencies": {
    "eas-cli": "^25.3.0"
  }
}

# Backend Database URL (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/chatapp?sslmode=disable"

# Backend HTTP & WebSocket Port
PORT=3000

# CORS Allowed Origin (e.g. * or http://localhost:8081)
CORS_ORIGIN="*"

# Mobile App API URL (for Expo client)
# Default is http://localhost:3000 (or http://10.0.2.2:3000 for Android emulator)
EXPO_PUBLIC_API_URL="http://localhost:3000"
